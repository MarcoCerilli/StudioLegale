---
import { MapPin, Phone, ShieldCheck, Share2, Mail, AtSign, Download, ArrowUp } from "lucide-astro";
---

<footer class="bg-sepia-dark text-cream pt-8 pb-24 md:py-7 px-4 sm:px-6 border-t border-rosewood-light/20 relative z-20 text-xs">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 items-center">
    
    {/* Colonna 1: Brand essenziale */}
    <div class="space-y-2">
      <div class="flex items-center gap-2">
        <ShieldCheck class="text-rosewood-light w-4 h-4 shrink-0" />
        <span class="font-serif text-rosewood-light text-xs sm:text-sm uppercase tracking-widest font-semibold">
          Studio Legale Fusco
        </span>
      </div>
      <p class="text-[11px] leading-relaxed text-cream/80 font-light max-w-xs">
        Difesa tecnica e tutela dei diritti a Terracina e in tutto il Lazio.
      </p>
      <div class="text-[9px] uppercase tracking-wider text-rosewood-light/70 font-medium flex flex-wrap gap-x-2">
        <span>P. IVA: 09857711007</span>
        <span>•</span>
        <span>Albo Roma N. A36343</span>
      </div>
    </div>

    {/* Colonna 2: Contatti compatti */}
    <div class="md:border-x md:border-white/10 md:px-6 py-1">
      <address class="not-italic space-y-1.5 text-[11px] text-cream/90">
        <div class="flex items-center gap-2.5">
          <MapPin class="w-3.5 h-3.5 text-rosewood-light shrink-0" />
          <span>Via Palermo, 16 — <strong class="text-white font-medium">Terracina (LT)</strong></span>
        </div>
        <div class="flex items-center gap-2.5">
          <Phone class="w-3.5 h-3.5 text-rosewood-light shrink-0" />
          <a href="tel:+393291246316" class="hover:text-rosewood-light font-bold text-white transition-colors">
            +39 329 124 6316
          </a>
        </div>
        <div class="flex items-center gap-2.5">
          <Mail class="w-3.5 h-3.5 text-rosewood-light shrink-0" />
          <a href="mailto:ass.legale@gmail.com" class="hover:text-white transition-colors">
            ass.legale@gmail.com
          </a>
        </div>
        <div class="flex items-center gap-2.5">
          <AtSign class="w-3.5 h-3.5 text-rosewood-light shrink-0" />
          <a href="mailto:annafusco@ordineavvocatiroma.org" class="hover:text-white text-[10px] transition-colors truncate">
            PEC: annafusco@ordineavvocatiroma.org
          </a>
        </div>
      </address>
    </div>

    {/* Colonna 3: QR bilanciato + Navigazione di servizio (senza CTA duplicati) */}
    <div class="flex flex-col sm:flex-row md:flex-col lg:flex-row items-center justify-center md:items-end lg:items-center md:justify-end gap-3.5 sm:gap-4 w-full">
      {/* QR Card: compatto e centrato da mobile (no w-full), arioso e comodo da desktop */}
      <div class="inline-flex items-center justify-start gap-3 sm:gap-3.5 bg-white/5 border border-white/15 px-3.5 py-2.5 sm:px-4 sm:py-3 rounded-2xl shadow-xs shrink-0">
        <div class="group relative p-1.5 sm:p-2 bg-white rounded-xl shadow-xs shrink-0 flex items-center justify-center">
          <img 
            src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=https://www.avvocatoannafusco.it&color=800020" 
            alt="QR Code Studio Fusco" 
            width="48" 
            height="48"
            class="w-11 h-11 sm:w-12 sm:h-12 block" 
          />
          <a 
            href="https://api.qrserver.com/v1/create-qr-code/?size=500x500&data=https://www.avvocatoannafusco.it&color=800020"
            download="QR_StudioLegaleFusco.png"
            class="absolute inset-0 bg-sepia-dark/90 rounded-xl opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center transition-all text-white backdrop-blur-xs"
            title="Scarica QR"
          >
            <Download class="w-3.5 h-3.5" />
          </a>
        </div>
        <div class="flex flex-col justify-center gap-0.5 sm:gap-1 pr-1">
          <span class="text-[9px] uppercase tracking-wider text-rosewood-light font-bold">QR Veloce</span>
          <button
            type="button"
            id="share-site-btn"
            class="inline-flex items-center gap-1.5 text-[9px] uppercase tracking-wider text-cream/80 hover:text-white transition-colors cursor-pointer py-0.5"
            aria-label="Condividi sito dello studio"
          >
            <Share2 class="w-3 h-3 text-rosewood-light" />
            <span>Condividi</span>
          </button>
        </div>
      </div>

      {/* Navigazione di servizio e Torna in alto (senza CTA duplicati) */}
      <div class="flex flex-col items-center sm:items-end gap-2 shrink-0">
        <a 
          href="#home"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 text-cream hover:text-white transition-all text-[10px] uppercase tracking-wider font-semibold group cursor-pointer shadow-xs active:scale-95"
          aria-label="Torna all'inizio della pagina"
        >
          <span>Torna in alto</span>
          <ArrowUp class="w-3.5 h-3.5 text-rosewood-light group-hover:-translate-y-0.5 transition-transform" />
        </a>
        
        <nav class="flex items-center justify-center sm:justify-end gap-1.5 text-[11px] text-cream/80 font-medium tracking-wider" aria-label="Navigazione rapida sezioni">
          <a href="#chi-sono" class="px-2.5 py-1 rounded-md hover:bg-white/10 hover:text-white transition-colors cursor-pointer">Profilo</a>
          <span class="text-white/20">•</span>
          <a href="#servizi" class="px-2.5 py-1 rounded-md hover:bg-white/10 hover:text-white transition-colors cursor-pointer">Attività</a>
          <span class="text-white/20">•</span>
          <a href="#attestati" class="px-2.5 py-1 rounded-md hover:bg-white/10 hover:text-white transition-colors cursor-pointer">Attestati</a>
        </nav>
      </div>
    </div>

  </div>

  {/* Barra Copyright compatta */}
  <div class="max-w-6xl mx-auto mt-6 pt-4 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-2 text-[9px] uppercase tracking-widest text-cream/50 text-center sm:text-left">
    <p>© 2026 Avv. Anna Fusco • Studio Legale Terracina</p>
    <p>Consulenza Civile, Penale e Lavoro</p>
  </div>
</footer>

<script>
  document.getElementById('share-site-btn')?.addEventListener('click', async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: "Studio Legale Avv. Anna Fusco",
          text: "Studio Legale Avvocato Anna Fusco - Terracina",
          url: window.location.origin
        });
      } catch (err) {
        // Ignora annullamento utente
      }
    } else {
      await navigator.clipboard.writeText(window.location.origin);
      alert("Link dello Studio Legale copiato negli appunti!");
    }
  });
</script>
