---
import { ShieldCheck, ArrowRight, Lock, CheckCircle2 } from "lucide-astro";
---

<section id="consulenza" class="py-16 md:py-20 bg-[#f8f6f2] text-charcoal border-t border-rosewood-light/20 relative">
  <div class="container mx-auto px-6 max-w-3xl text-center">
    
    <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.3em] text-rosewood bg-rosewood/10 px-4 py-1.5 rounded-full mb-4">
      <Lock class="w-3 h-3" />
      <span>Consulenza Riservata</span>
    </div>
    
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-charcoal leading-tight mb-3 sm:mb-4 font-normal">
      Parla del tuo caso direttamente con l'Avvocato
    </h2>
    
    <p class="text-sm md:text-base text-charcoal/75 font-light leading-relaxed max-w-xl mx-auto mb-6 sm:mb-8">
      Una prima valutazione chiara, riservata e tempestiva. Non occorre compilare form complessi: spiegaci la tua situazione nella nostra chat protetta.
    </p>

    {/* CTA Principale: coerente con il pulsante Prenota della Navbar (bg-rosewood -> hover:bg-cream hover:text-sepia-dark) */}
    <div class="flex items-center justify-center mb-6 sm:mb-8">
      <button 
        type="button"
        data-open-chat
        data-chat-msg="Salve Avvocato Fusco, desidero sottoporle il mio caso per una prima valutazione."
        class="cursor-pointer group inline-flex items-center justify-center gap-2.5 sm:gap-3 bg-rosewood border-2 border-rosewood text-white px-5 sm:px-10 py-3.5 sm:py-4 rounded-full font-bold uppercase tracking-[0.14em] sm:tracking-[0.2em] text-xs transition-all duration-300 hover:bg-cream hover:text-sepia-dark hover:border-sepia-dark shadow-md hover:shadow-xl active:scale-95 min-h-12 w-full sm:w-auto max-w-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rosewood"
        aria-label="Avvia chat interna per richiedere una consulenza legale"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#25D366" class="w-4.5 h-4.5 shrink-0 drop-shadow-xs" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
        </svg>
        <span>Scrivici in Chat Riservata</span>
        <ArrowRight class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
      </button>
    </div>

    {/* Punti di rassicurazione deontologica (Zero contatti duplicati rispetto al footer) */}
    <div class="pt-6 border-t border-rosewood-light/15 flex flex-wrap items-center justify-center gap-6 text-xs text-charcoal/70">
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-rosewood shrink-0" />
        <span>Segreto professionale e deontologia forense</span>
      </div>
      <div class="flex items-center gap-2">
        <CheckCircle2 class="w-4 h-4 text-green-600 shrink-0" />
        <span>Nessuna registrazione richiesta</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
        <span>Risposta rapida dello Studio</span>
      </div>
    </div>

  </div>
</section>

