---
---

<section id="home" class="relative h-[92dvh] md:h-[90dvh] min-h-140 flex items-center overflow-hidden bg-sepia-dark pt-16 md:pt-20">
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-avvocato.jpg"
      alt="Studio Legale Avvocato Anna Fusco Terracina"
      class="object-cover w-full h-full opacity-95 object-center"
    />
    <!-- Gradienti schiariti e caldi per valorizzare la luminosa foto diurna mantenendo la leggibilità -->
    <div class="absolute inset-0 bg-linear-to-r from-black/70 via-black/35 to-transparent md:from-black/60 md:via-black/20"></div>
    <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-black/20"></div>
  </div>

  <div class="relative z-10 container mx-auto px-6 md:px-12 lg:px-24">
    <div class="max-w-4xl">
      <div class="flex items-center gap-3 md:gap-4 mb-6 md:mb-8">
        <div class="h-px w-8 md:w-12 bg-white"></div>
        <p class="text-white/80 text-[9px] md:text-[10px] tracking-[0.3em] md:tracking-[0.5em] uppercase font-bold m-0 p-0">
          Studio Legale — Avvocato a Terracina, Latina e Roma
        </p>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-7xl lg:text-[100px] font-serif mb-6 md:mb-10 leading-[1.1] md:leading-[0.9] tracking-tighter text-white drop-shadow-sm">
        Difesa tecnica, <br />
        <span class="italic font-light text-white">valore umano.</span>
      </h1>

      <p class="text-sm sm:text-base md:text-xl text-white/95 mb-8 md:mb-12 max-w-xl leading-relaxed font-light drop-shadow-xs">
        Lo <strong>Studio Legale Fusco</strong>, fondato dall'<strong>Avvocato Fusco a Terracina</strong> e operativo nei Fori di <strong>Latina e Roma</strong>, offre assistenza legale specialistica, fondata sul rigore accademico e sulla tutela dinamica dei diritti.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 md:gap-6">
        <button
          type="button"
          data-open-chat
          data-chat-msg="Salve, vorrei prenotare una consulenza legale."
          class="cursor-pointer flex items-center justify-center gap-2.5 sm:gap-3 px-6 py-3.5 sm:px-8 sm:py-4 md:px-10 md:py-5 bg-white text-rosewood border border-transparent font-bold transition-all duration-300 hover:bg-rosewood hover:text-white hover:border-rosewood hover:shadow-[0_8px_25px_rgba(139,94,94,0.5)] rounded-full group shadow-xl"
        >
          <span class="uppercase tracking-[0.2em] text-[10px]">Prenota Consulenza</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>

        <a
          href="#servizi"
          class="flex items-center justify-center px-6 py-3.5 sm:px-8 sm:py-4 md:px-10 md:py-5 border border-white/50 hover:border-white text-white transition-all duration-300 rounded-full backdrop-blur-md bg-black/15 hover:bg-black/25"
        >
          <span class="uppercase tracking-[0.2em] text-[10px]">Aree di Competenza</span>
        </a>
      </div>
    </div>
  </div>
</section>
