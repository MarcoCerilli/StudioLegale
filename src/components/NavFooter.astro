---
import { Phone, Briefcase, Calendar } from "@lucide/astro";
---

<!-- NavFooter: Barra di navigazione rapida inferiore per dispositivi mobili (ottimizzata per iOS Safari e PageSpeed) -->
<nav 
  id="navfooter"
  class="md:hidden fixed bottom-[max(0.75rem,env(safe-area-inset-bottom,12px))] left-1/2 -translate-x-1/2 z-40 w-[94%] max-w-90 rounded-full bg-[#faf8f5]/96 backdrop-blur-xl border border-rosewood/25 shadow-[0_12px_40px_rgba(0,0,0,0.38)] px-1.5 py-1.5 flex items-center justify-between text-charcoal transition-transform duration-300"
  aria-label="Navigazione rapida inferiore"
>
  <a 
    href="tel:+393291246316"
    class="flex-1 flex flex-col items-center justify-center py-1 rounded-full hover:bg-black/5 active:scale-95 transition-all text-charcoal min-h-11 focus-visible:outline-2 focus-visible:outline-rosewood"
    aria-label="Chiama lo studio legale"
  >
    <Phone class="w-4 h-4 text-rosewood mb-0.5" />
    <span class="text-[9px] font-bold tracking-wider uppercase">Chiama</span>
  </a>

  <a 
    href="#servizi"
    class="flex-1 flex flex-col items-center justify-center py-1 rounded-full hover:bg-black/5 active:scale-95 transition-all text-charcoal min-h-11 focus-visible:outline-2 focus-visible:outline-rosewood"
    aria-label="Consulta le aree di attività"
  >
    <Briefcase class="w-4 h-4 text-rosewood mb-0.5" />
    <span class="text-[9px] font-bold tracking-wider uppercase">Aree</span>
  </a>

  <button 
    id="navfooter-chat-btn"
    type="button"
    data-open-chat
    data-chat-msg="Salve, desidero richiedere assistenza legale via chat."
    class="flex-1 flex flex-col items-center justify-center py-1 rounded-full hover:bg-black/5 active:scale-95 transition-all text-charcoal min-h-11 focus-visible:outline-2 focus-visible:outline-rosewood cursor-pointer"
    aria-label="Apri assistenza chat"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#25D366" class="w-4 h-4 mb-0.5 drop-shadow-xs" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
    </svg>
    <span class="text-[9px] font-bold tracking-wider uppercase">Chat</span>
  </button>

  <button 
    type="button"
    data-open-chat
    data-chat-msg="Salve, vorrei prenotare una consulenza legale."
    class="group flex-1 flex flex-col items-center justify-center py-1.5 bg-rosewood text-white border border-rosewood rounded-full shadow-md hover:bg-cream hover:text-sepia-dark hover:border-sepia-dark active:scale-95 transition-all min-h-11 focus-visible:outline-2 focus-visible:outline-rosewood font-bold cursor-pointer"
    aria-label="Prenota una consulenza legale"
  >
    <Calendar class="w-4 h-4 mb-0.5 text-current" />
    <span class="text-[9px] tracking-wider uppercase font-bold">Prenota</span>
  </button>
</nav>
